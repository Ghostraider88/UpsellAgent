# ── UpsellAgent configuration ────────────────────────────────────────────────
# Copy to `.env` and fill in. The app runs fully in MOCK mode without any keys.

# Core
APP_ENV=development
# Host that the BROWSER uses to reach the API. Leave as localhost for local use.
# For remote access (e.g. a Docker server), set this to the host's IP/hostname,
# e.g. PUBLIC_HOST=192.168.1.50 — otherwise the web UI calls localhost in YOUR
# browser and the backend appears unreachable.
PUBLIC_HOST=localhost
DATABASE_URL=postgresql+psycopg://upsell:upsell@db:5432/upsell
REDIS_URL=redis://redis:6379/0

# LLM (optional — falls back to heuristic scoring if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Mock people source. Leave unset for AUTO: synthetic demo people are used only
# as a fallback and disappear automatically once a real source (e.g. SerpAPI) is
# configured. Set true to force the demo roster, false to never use it.
ENABLE_MOCK_DATA=

# Compliant data sources (optional — mock data used if unset).
# SerpAPI provides real news SIGNALS (Google News) about the company — it does
# NOT enumerate employees. Get a key at https://serpapi.com.
SERPAPI_API_KEY=
PDL_API_KEY=
APOLLO_API_KEY=

# ── Shadow / fallback scraping sources ───────────────────────────────────────
# DISABLED by default. Enabling requires admin role at request time and is
# fully audit-logged. Only enable where legally permitted (LinkedIn/Xing data is
# ToS-restricted and GDPR-sensitive — document your lawful basis).
ENABLE_SHADOW_SOURCES=false
# LinkedIn/Xing data is fetched via a licensed provider, not a self-built
# scraper. Provider: "proxycurl" (default) or "brightdata".
SHADOW_PROVIDER=proxycurl
PROXYCURL_API_KEY=
BRIGHTDATA_API_KEY=
# Max people fetched per company in shadow mode (cost / volume cap).
SHADOW_MAX_PEOPLE=25

# Auth (Phase 4 — placeholder)
JWT_SECRET=change-me-in-production
